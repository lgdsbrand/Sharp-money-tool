# Copy this file to .env and fill in what you have. Everything is optional in DEMO_MODE.
# NEVER commit .env, and never paste these values into chats or the browser.

# ---- mode --------------------------------------------------------------------
DEMO_MODE=true              # true = fake sample data, no keys needed. Set false to go live.
ADMIN_TOKEN=                # set a long random string in production: protects refresh / add-play / delete-play
CORS_ORIGINS=*              # production: https://lgdsanalytics.vercel.app
SPORTS=nba,nfl,nhl,mlb,ncaaf,ncaab
REFRESH_SECONDS=120         # background refresh of exchange money (0 = off, use the cron instead)
DISPLAY_TZ=America/New_York # decides which "night" a game belongs to

# ---- accounts -----------------------------------------------------------------------
REQUIRE_LOGIN=true          # false = no login screen (local use only)
ALLOW_SIGNUP=true           # false = only ALLOWED_EMAILS / ADMIN_EMAILS can create accounts
ADMIN_EMAILS=               # comma list; these users can push model picks / splits
ALLOWED_EMAILS=             # comma list for invite-only
SOURCE_TIMEOUT=30           # seconds before one slow data source is skipped

# ---- storage (leave empty to use a local SQLite file) -------------------------------
SUPABASE_URL=               # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=       # service_role key. SERVER ONLY. Never put it in the website code.

# ---- odds: Pinnacle + sportsbooks for +EV and auto-grading ----------------------------
ODDS_API_KEY=               # the-odds-api.com
ODDS_BOOKMAKERS=pinnacle,draftkings,fanduel,betmgm,caesars
ODDS_REFRESH_SECONDS=14400   # odds are cached this long to save API credits

# ---- exchanges (sharp money) ----------------------------------------------------------
KALSHI_ENABLED=true         # public market data, no key
KALSHI_METRIC=volume        # volume | open_interest | liquidity  (what counts as "money")
# KALSHI_SERIES_NCAAF=KXNCAAFGAME     # override if a college series shows 0 games
# KALSHI_SERIES_NCAAB=KXNCAAMBGAME

NOVIG_ENABLED=false         # set true: reads Novig's public market data, NO key needed
NOVIG_BASE_URL=             # leave empty for the real exchange (https://api.novig.com - confirm in docs.novig.com)
#                           # for play-money testing use https://api.paper.novig.com
# NOVIG_API_KEY_ID=         # not used for reading; only needed if we ever place orders
# NOVIG_PRIVATE_KEY_PATH=   # same - keep private keys out of git

PROPHETX_ENABLED=false
PROPHETX_AFFILIATE_KEY=   # the Market Data key (a Trading key does not work here)
# PROPHETX_BASE_URL=https://api.sandbox.prophetx.dev/partner   # only for a sandbox key; default is production

POLYMARKET_ENABLED=false    # optional extra exchange, public data

# ---- public betting % -------------------------------------------------------------------
DK_SPLITS_ENABLED=true
# DK_SPLITS_URL=https://dknetwork.draftkings.com/draftkings-sportsbook-betting-splits/
# DK_SPLITS_URL_NBA=...     # paste the address-bar URL after picking the league on the DK splits page
# DK_SPLITS_ORDER=bets,handle  # only if the Handle/Bets columns come out swapped

# ---- your models (for the "MODEL AGREES" flag) -------------------------------------------
MODEL_PICKS_URL=            # endpoint returning [{"away":"BOS","home":"PHI","pick":"BOS","prob":0.64}, ...]
MODEL_PICKS_TOKEN=

# ---- thresholds -------------------------------------------------------------------------
MIN_LIQUIDITY_DEFAULT=100000
HEAVY_SHARP_PCT=65          # % of exchange money on one side
FADE_PUBLIC_PCT=55          # public bets % on the other side
BIG_MONEY_TOTAL=500000
MIN_EV_PCT=2

# ---- nightly log ----------------------------------------------------------------------
NIGHTLY_ENABLED=true
NIGHTLY_UNIT=25             # flat stake per auto-logged play
NIGHTLY_MIN_TOTAL=100000    # only log plays with at least this much exchange money
